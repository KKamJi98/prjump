{
  "comment": "Parity corpus: prjump 0.2.2 (Python) vs prj (Rust). Schema in scripts/parity/README.md.",
  "defaults": {
    "args": ["open", "--print", "-t", "main", "-s", "feature/x"],
    "remote": "git@github.com:o/r.git"
  },
  "cases": [
    {"name": "url/ssh-scp", "remote": "git@github.com:octocat/Hello-World.git"},
    {"name": "url/https", "remote": "https://github.com/octocat/Hello-World.git"},
    {"name": "url/http-unsupported-host", "remote": "http://github.example.com/org/repo"},
    {"name": "url/http-provider-override", "remote": "http://github.example.com/org/repo", "args": ["open", "--print", "-t", "main", "-s", "feature/x", "--provider", "github"]},
    {"name": "url/git-protocol", "remote": "git://github.com/octocat/repo.git"},
    {"name": "url/single-segment", "remote": "https://github.com/single-segment"},
    {"name": "url/ssh-no-colon", "remote": "git@github.com/no-colon/repo.git"},
    {"name": "url/bitbucket-ssh", "remote": "git@bitbucket.org:atlassian/stash.git"},
    {"name": "url/bitbucket-https-no-target", "remote": "https://bitbucket.org/team/repo.git", "args": ["open", "--print", "-s", "feature/x"]},
    {"name": "url/https-port", "remote": "https://github.com:8443/org/repo.git"},
    {"name": "url/ssh-github-port-443", "remote": "ssh://git@ssh.github.com:443/org/repo.git"},
    {"name": "url/altssh-bitbucket", "remote": "git@altssh.bitbucket.org:team/repo.git"},
    {"name": "url/scp-mixed-case-host", "remote": "git@GitHub.com:Org/Repo.git"},
    {"name": "url/https-mixed-case-host", "remote": "https://GitHub.COM/Org/Repo"},
    {"name": "url/https-credentials", "remote": "https://user:s3cr3t@github.com/org/repo.git"},
    {"name": "url/ipv6", "remote": "https://[::1]:3000/org/repo", "args": ["open", "--print", "-t", "main", "-s", "x", "--provider", "github"]},
    {"name": "url/ipv6-unclosed", "remote": "https://[::1/org/repo"},
    {"name": "url/ipv6-invalid", "remote": "https://[abc]/o/r"},
    {"name": "url/ipv4-in-brackets", "remote": "https://[1.2.3.4]/o/r"},
    {"name": "url/ipv6-scoped", "remote": "https://[fe80::1%25eth0]/o/r", "args": ["open", "--print", "-t", "main", "-s", "x", "--provider", "github"]},
    {"name": "url/ipvfuture", "remote": "https://[v1.x]/o/r", "args": ["open", "--print", "-t", "main", "-s", "x", "--provider", "github"]},
    {"name": "url/ssh-alias-host", "remote": "git@github-work:org/repo.git"},
    {"name": "url/ssh-alias-host-override", "remote": "git@github-work:org/repo.git", "args": ["open", "--print", "-t", "main", "-s", "x", "--provider", "github"]},
    {"name": "url/dotdot-path", "remote": "https://github.com/org/../repo/x"},
    {"name": "url/percent-path", "remote": "https://github.com/org/my%20repo"},
    {"name": "url/notgithub", "remote": "https://notgithub.com/org/repo"},
    {"name": "url/gitlab-subgroup", "remote": "https://gitlab.com/group/sub/repo.git"},
    {"name": "url/gitlab-subgroup-override", "remote": "https://gitlab.com/group/sub/repo.git", "args": ["open", "--print", "-t", "main", "-s", "x", "--provider", "github"]},
    {"name": "url/trailing-slash", "remote": "https://github.com/org/repo/"},
    {"name": "url/query-fragment", "remote": "https://github.com/o/r.git?x=1#frag"},
    {"name": "url/https-params", "remote": "https://github.com/o/r;params"},
    {"name": "url/ssh-params", "remote": "ssh://git@github.com/o/r.git;x"},
    {"name": "url/upper-scheme", "remote": "GIT+SSH://git@github.com/o/r.git"},
    {"name": "url/file-scheme", "remote": "file:///srv/repo.git"},
    {"name": "url/invalid-scheme", "remote": "1http://github.com/o/r"},
    {"name": "url/host-only", "remote": "https://github.com"},
    {"name": "url/scp-no-user", "remote": "github.com:o/r"},
    {"name": "url/scp-empty-user", "remote": "@github.com:o/r"},
    {"name": "url/scp-empty-host", "remote": "user@:o/r"},
    {"name": "url/local-path", "remote": "/srv/git/repo.git"},
    {"name": "url/unicode-host", "remote": "https://GÍTHUB.com/o/r"},
    {"name": "url/github-enterprise-subdomain", "remote": "git@github.mycompany.github.com:org/repo.git"},

    {"name": "branch/encoding", "args": ["open", "--print", "-t", "release/2026 rc", "-s", "a b/c~d.e_f-g+h@i&j?k#l%m"]},
    {"name": "branch/unicode", "args": ["open", "--print", "-t", "main", "-s", "기능/한글"]},
    {"name": "branch/bitbucket-encoding", "remote": "git@bitbucket.org:t/r.git", "args": ["open", "--print", "-t", "a/b", "-s", "c d"]},

    {"name": "current/main", "commit": true, "args": ["open", "--print", "-t", "main"]},
    {"name": "current/slash-branch", "commit": true, "setup": [["switch", "-q", "-c", "feature/x"]], "args": ["open", "--print", "-t", "main"]},
    {"name": "current/detached", "commit": true, "setup": [["switch", "-q", "--detach"]], "args": ["open", "--print", "-t", "main"]},
    {"name": "current/unborn", "args": ["open", "--print", "-t", "main"]},
    {"name": "current/ambiguous-tag", "commit": true, "setup": [["switch", "-q", "-c", "foo"], ["tag", "foo"]], "args": ["open", "--print", "-t", "main"]},
    {"name": "current/empty-source-flag", "commit": true, "args": ["open", "--print", "-t", "main", "--source", ""]},

    {"name": "default/symbolic-ref-main", "commit": true, "setup": [["update-ref", "refs/remotes/origin/main", "HEAD"], ["symbolic-ref", "refs/remotes/origin/HEAD", "refs/remotes/origin/main"]], "args": ["open", "--print", "-s", "x"]},
    {"name": "default/symbolic-ref-slash", "commit": true, "setup": [["update-ref", "refs/remotes/origin/release/2026", "HEAD"], ["symbolic-ref", "refs/remotes/origin/HEAD", "refs/remotes/origin/release/2026"]], "args": ["open", "--print", "-s", "x"]},
    {"name": "default/empty-target-flag", "commit": true, "setup": [["update-ref", "refs/remotes/origin/main", "HEAD"], ["symbolic-ref", "refs/remotes/origin/HEAD", "refs/remotes/origin/main"]], "args": ["open", "--print", "--target", "", "-s", "x"]},
    {"name": "default/candidate-develop", "commit": true, "setup": [["update-ref", "refs/remotes/origin/develop", "HEAD"]], "args": ["open", "--print", "-s", "x"]},
    {"name": "default/candidate-order", "commit": true, "setup": [["update-ref", "refs/remotes/origin/trunk", "HEAD"], ["update-ref", "refs/remotes/origin/master", "HEAD"]], "args": ["open", "--print", "-s", "x"]},
    {"name": "default/none", "commit": true, "args": ["open", "--print", "-s", "x"]},
    {"name": "default/remote-show", "commit": true, "upstream": [["commit", "-q", "--allow-empty", "-m", "up"], ["switch", "-q", "-c", "develop"]], "env": {"GIT_SSH_COMMAND": "{tmp}/fake-ssh"}, "args": ["open", "--print", "-s", "x"]},
    {"name": "default/remote-show-slash", "commit": true, "upstream": [["commit", "-q", "--allow-empty", "-m", "up"], ["switch", "-q", "-c", "release/2026"]], "env": {"GIT_SSH_COMMAND": "{tmp}/fake-ssh"}, "args": ["open", "--print", "-s", "x"]},
    {"name": "default/bitbucket-skips-lookup", "commit": true, "remote": "git@bitbucket.org:t/r.git", "args": ["open", "--print", "-s", "x"]},

    {"name": "env/not-a-repo", "repo": false},
    {"name": "env/no-such-remote", "args": ["open", "--print", "-t", "main", "-s", "x", "--remote", "upstream"]},
    {"name": "env/empty-remote-url", "remote": null, "setup": [["config", "remote.origin.url", ""]]},
    {"name": "env/upstream-remote", "remote": null, "setup": [["remote", "add", "upstream", "git@github.com:up/r.git"]], "args": ["open", "--print", "-t", "main", "-s", "x", "--remote", "upstream"]},

    {"name": "browser/opens", "args": ["open", "-t", "main", "-s", "feature/x"]},
    {"name": "browser/second-entry", "env": {"BROWSER": "/nonexistent/browser:{tmp}/browser.sh"}, "args": ["open", "-t", "main", "-s", "x"]},

    {"name": "args/no-command", "args": [], "compare": "status"},
    {"name": "args/version", "args": ["--version"]},
    {"name": "args/version-prefix", "args": ["--vers"]},
    {"name": "args/short-V", "args": ["-V"], "compare": "status"},
    {"name": "args/help", "args": ["-h"], "compare": "status"},
    {"name": "args/help-prefix", "args": ["--h"], "compare": "status"},
    {"name": "args/open-help", "args": ["open", "-h"], "compare": "status"},
    {"name": "args/open-help-long", "args": ["open", "--help"], "compare": "status"},
    {"name": "args/unknown-command", "args": ["bogus"], "compare": "status"},
    {"name": "args/open-version", "args": ["open", "--version"], "compare": "status"},
    {"name": "args/print-before-command", "args": ["--print", "open"], "compare": "status"},
    {"name": "args/extra-positional", "args": ["open", "extra"], "compare": "status"},
    {"name": "args/double-dash", "args": ["open", "--", "-x"], "compare": "status"},
    {"name": "args/missing-value", "args": ["open", "-t"], "compare": "status"},
    {"name": "args/value-looks-like-flag", "args": ["open", "-t", "-x", "-s", "y", "--print"], "compare": "status"},
    {"name": "args/negative-number-value", "args": ["open", "-t", "-1", "-s", "y", "--print"]},
    {"name": "args/provider-wrong-case", "args": ["open", "--provider", "GitHub", "-t", "m", "-s", "x", "--print"], "compare": "status"},
    {"name": "args/provider-invalid", "args": ["open", "--provider", "gitlab", "-t", "m", "-s", "x", "--print"], "compare": "status"},
    {"name": "args/ambiguous-prefix", "args": ["open", "--p", "github", "-t", "m", "-s", "x"], "compare": "status"},
    {"name": "args/prefixes", "args": ["open", "--pri", "--tar", "dev", "--sou", "x"]},
    {"name": "args/provider-prefix", "args": ["open", "--pro", "bitbucket", "--print", "-t", "m", "-s", "x"]},
    {"name": "args/remote-prefix", "args": ["open", "--rem", "origin", "--print", "-t", "m", "-s", "x"]},
    {"name": "args/repeated-target", "args": ["open", "-t", "a", "-t", "b", "-s", "x", "--print"]},
    {"name": "args/repeated-print", "args": ["open", "--print", "--print", "-t", "m", "-s", "x"]},
    {"name": "args/short-equals", "args": ["open", "-t=main", "-s=x", "--print"]},
    {"name": "args/short-attached", "args": ["open", "-tmain", "-sx", "--print"]},
    {"name": "args/long-equals", "args": ["open", "--target=main", "--source=x", "--print"]},
    {"name": "args/long-equals-empty", "args": ["open", "--target=", "--source=x", "--print"]},
    {"name": "args/option-after-print", "args": ["open", "--print", "-s", "x", "-t", "m"]}
  ]
}
